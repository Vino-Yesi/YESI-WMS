# YESI-WMS — Cloud + Edge Hybrid configuration
# Copy to .env and populate with your project's environment-specific credentials.
# Never commit real keys or service_role secrets to Git.
#
# Every VITE_* value is inlined into the browser bundle, so only publishable
# (anon) credentials belong here. The `service_role` key is used exclusively by
# the `wms-api` Edge Function and must live in Supabase Edge Function secrets.

# ── Cloud scope (optional — omit BOTH for Offline-Edge mode) ────────────────
# When either value is missing or invalid, the app boots into an isolated
# offline warehouse: all lifecycle writes stay in IndexedDB and queue in the
# transactional outbox until a cloud scope is configured.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Tenancy ─────────────────────────────────────────────────────────────────
# Every operational row (balances, orders, movements, outbox events) is stamped
# with BOTH of these. Malformed values are normalized and reported on the login
# screen, never silently ignored.
VITE_WMS_TENANT_CODE=YESI-FZCO
VITE_WMS_DEFAULT_WAREHOUSE=DXB-FC1

# ── Demo dataset (development only) ─────────────────────────────────────────
# Set to `true` to seed the sample Ozon wave (SKUs, balances, orders) on a
# first-run database. A production build (`vite build`) NEVER seeds demo data
# unless this flag is explicitly `true`; first-run access is then granted only
# through the admin bootstrap flow on the login screen.
VITE_WMS_ENABLE_DEMO_SEED=

# ── Edge Function gateway secrets (NOT for this file) ───────────────────────
# Configure these with `supabase secrets set` on the project, never in .env:
#   WMS_ALLOWED_ORIGINS  comma-separated browser origins allowed by the gateway
#                        CORS policy. When unset, all browser origins are
#                        rejected (server-to-server calls still work).
#   WMS_METRICS_TOKEN    bearer token required by GET ?action=metrics.
#   WMS_WEBHOOK_SECRET   HMAC-SHA256 secret for POST ?action=webhook_order
#                        (headers: x-yesi-signature or x-webhook-secret).
